# =============================================================================
# Learning Analytics Microservices · variables de entorno
# =============================================================================
# Copia este archivo a `.env` y rellena los valores reales si quieres.
# Los valores por defecto del compose funcionan para desarrollo local sin .env.
# NUNCA hagas commit del .env real con credenciales.
# =============================================================================

# -----------------------------------------------------------------------------
# Entorno general
# -----------------------------------------------------------------------------
APP_ENV=local
APP_DEBUG=true

# -----------------------------------------------------------------------------
# PostgreSQL passwords (uno por servicio, patrón Database per Service)
# -----------------------------------------------------------------------------
DB_PASSWORD_GATEWAY=gateway_pass
DB_PASSWORD_IDENTITY=identity_pass
DB_PASSWORD_INGESTION=ingestion_pass
DB_PASSWORD_TELEMETRY=telemetry_pass
DB_PASSWORD_ALERTING=alerting_pass
DB_PASSWORD_NOTIFICATION=notification_pass

# -----------------------------------------------------------------------------
# RabbitMQ
# -----------------------------------------------------------------------------
RABBITMQ_USER=noctua
RABBITMQ_PASSWORD=noctua_pass
# AMQP port: 5672 (interno entre servicios)
# Management UI: http://localhost:15672 (usuario/contraseña de arriba)

# -----------------------------------------------------------------------------
# Kafka
# -----------------------------------------------------------------------------
# Acceso interno (entre servicios en la red Docker):   kafka:9092
# Acceso externo (desde tu laptop con kafka-cli, etc): localhost:9094

# -----------------------------------------------------------------------------
# Redis (sin password en desarrollo local)
# -----------------------------------------------------------------------------
# Host:port interno: redis:6379

# -----------------------------------------------------------------------------
# JWT (se usa cuando construyamos Identity & Access en D2)
# -----------------------------------------------------------------------------
JWT_SECRET=cambiar-en-D2-con-php-artisan-jwt-secret
JWT_TTL_MINUTES=60

# -----------------------------------------------------------------------------
# Simulador LMS (se usa cuando lo construyamos en D3)
# -----------------------------------------------------------------------------
SIMULATOR_INTERVAL_SECONDS=5
SIMULATOR_API_KEY=cambiar-cuando-ingestion-emita-api-keys

# =============================================================================
# Puertos expuestos al host (referencia)
# =============================================================================
# 8000  → API Gateway
# 8001  → Identity & Access
# 8002  → Event Ingestion
# 8003  → Telemetry Processing
# 8004  → Alerting Service
# 8005  → Notification Dispatcher
# 5433  → PostgreSQL del Gateway (debugging con DBeaver/pgAdmin)
# 5672  → RabbitMQ AMQP
# 15672 → RabbitMQ Management UI
# 9094  → Kafka external listener
# =============================================================================