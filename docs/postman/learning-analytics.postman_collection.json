              "host": ["{{BASE_NOTIFICATION}}"],
              "path": ["api", "notifications", "recent"],
              "query": [
                { "key": "channel", "value": "email" },
                { "key": "limit", "value": "10" }
              ]
            }
          }
        },
        {
          "name": "Notification stats (agregados)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{BASE_NOTIFICATION}}/api/notifications/stats",
              "host": ["{{BASE_NOTIFICATION}}"],
              "path": ["api", "notifications", "stats"]
            }
          }
        },
        {
          "name": "Notifications by incident",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{BASE_NOTIFICATION}}/api/notifications/by-incident/{{LAST_INCIDENT_ID}}",
              "host": ["{{BASE_NOTIFICATION}}"],
              "path": ["api", "notifications", "by-incident", "{{LAST_INCIDENT_ID}}"]
            }
          }
        }
      ]
    },
    {
      "name": "🧪 Demo Flows (casos de uso)",
      "description": "Secuencias de requests que ejercitan flujos completos del sistema. Ejecutar en orden de arriba a abajo.",
      "item": [
        {
          "name": "Flujo A: Disparar incidente R1 (15 eventos burst)",
          "description": "Envía 15 eventos seguidos para el mismo estudiante. Dispara la regla R1 (critical) por exceso de actividad sostenida. Después de ejecutar, esperar ~10s y consultar 'List all incidents' para ver el incidente generado.",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Institution-Id", "value": "{{INSTITUTION_ID}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"eventname\": \"\\\\core\\\\event\\\\course_viewed\",\n  \"userid\": 42,\n  \"courseid\": 7,\n  \"timecreated\": {{$timestamp}}\n}"
            },
            "url": {
              "raw": "{{BASE_INGESTION}}/api/events/moodle",
              "host": ["{{BASE_INGESTION}}"],
              "path": ["api", "events", "moodle"]
            }
          }
        },
        {
          "name": "Flujo A.2: Validar incidente generado",
          "description": "Después de Flujo A (ejecutarlo ~15 veces dándole F5 rápido al botón Send), consultar este endpoint para ver el incidente disparado.",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{BASE_ALERTING}}/api/incidents?severity=critical",
              "host": ["{{BASE_ALERTING}}"],
              "path": ["api", "incidents"],
              "query": [
                { "key": "severity", "value": "critical" }
              ]
            }
          }
        },
        {
          "name": "Flujo A.3: Validar notificaciones generadas",
          "description": "Cada incidente genera 3 notificaciones (email + slack + log). Verificar aquí.",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{BASE_NOTIFICATION}}/api/notifications/recent?limit=10",
              "host": ["{{BASE_NOTIFICATION}}"],
              "path": ["api", "notifications", "recent"],
              "query": [
                { "key": "limit", "value": "10" }
              ]
            }
          }
        },
        {
          "name": "Flujo B.1: Acknowledge último incidente",
          "description": "Después de listar incidentes, este request reconoce el último (usa variable LAST_INCIDENT_ID auto-poblada).",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"acknowledged_by\": \"admin@learning.test\"\n}"
            },
            "url": {
              "raw": "{{BASE_ALERTING}}/api/incidents/{{LAST_INCIDENT_ID}}/acknowledge",
              "host": ["{{BASE_ALERTING}}"],
              "path": ["api", "incidents", "{{LAST_INCIDENT_ID}}", "acknowledge"]
            }
          }
        },
        {
          "name": "Flujo B.2: Resolver incidente",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"resolved_by\": \"admin@learning.test\",\n  \"resolution_notes\": \"Estudiante contactado, situación clarificada.\"\n}"
            },
            "url": {
              "raw": "{{BASE_ALERTING}}/api/incidents/{{LAST_INCIDENT_ID}}/resolve",
              "host": ["{{BASE_ALERTING}}"],
              "path": ["api", "incidents", "{{LAST_INCIDENT_ID}}", "resolve"]
            }
          }
        },
        {
          "name": "Flujo C: Health check todos los servicios",
          "description": "Ejecuta health en los 5 servicios en orden. Útil al inicio de la demo para mostrar que todo está vivo.",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{BASE_INGESTION}}/api/health",
              "host": ["{{BASE_INGESTION}}"],
              "path": ["api", "health"]
            }
          }
        }
      ]
    }
  ]
}
