                { "key": "limit", "value": "20" }
              ]
            }
          }
        },
        {
          "name": "Recent failed notifications",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{BASE_NOTIFICATION}}/api/notifications/recent?status=failed",
              "host": ["{{BASE_NOTIFICATION}}"],
              "path": ["api", "notifications", "recent"],
              "query": [
                { "key": "status", "value": "failed" }
              ]
            }
          }
        },
        {
          "name": "Recent email notifications",
          "request": {
            "method": "GET",
            "url": {
