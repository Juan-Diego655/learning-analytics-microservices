# ============================================================
# Environment & secrets
# ============================================================
.env
.env.local
.env.*.local
*.pem
*.key
secrets/

# ============================================================
# Laravel (per service)
# ============================================================
**/vendor/
**/node_modules/
**/public/storage
**/public/hot
**/storage/*.key
**/storage/app/*
!**/storage/app/.gitkeep
**/storage/framework/cache/data/*
!**/storage/framework/cache/data/.gitkeep
**/storage/framework/sessions/*
!**/storage/framework/sessions/.gitkeep
**/storage/framework/views/*
!**/storage/framework/views/.gitkeep
**/storage/logs/*
!**/storage/logs/.gitkeep
**/bootstrap/cache/*.php
**/.phpunit.result.cache
**/.phpunit.cache
**/Homestead.json
**/Homestead.yaml
**/auth.json
**/npm-debug.log
**/yarn-error.log
**/.fleet
**/.nova

# ============================================================
# Python (simulador y eventual Predictive Analytics)
# ============================================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/
ENV/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
dist/
build/
.coverage
htmlcov/
.tox/

# ============================================================
# Docker
# ============================================================
# Datos de volúmenes locales (si se usan bind mounts)
docker-data/
.docker/
# No ignoramos docker-compose.yml ni Dockerfile (van versionados)

# ============================================================
# IDE / Editors
# ============================================================
.idea/
.vscode/*
!.vscode/settings.json.example
!.vscode/extensions.json
*.swp
*.swo
*~
.project
.settings/
.DS_Store
Thumbs.db

# ============================================================
# Logs / temp
# ============================================================
*.log
logs/
tmp/
temp/
*.bak
*.tmp

# ============================================================
# OS
# ============================================================
.DS_Store
.AppleDouble
.LSOverride
Icon
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Desktop.ini

# ============================================================
# Postman (mantener la collection versionada, ignorar workspace local)
# ============================================================
postman/*.environment.json
postman/*-bk-*.json
